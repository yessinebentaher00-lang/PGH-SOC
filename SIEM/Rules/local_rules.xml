    <mitre>
      <id>T1558</id>
    </mitre>
  </rule>

</group>

<!-- ============================================= -->
<!-- WINDOWS AD ENUMERATION DETECTION              -->
<!-- ============================================= -->

<group name="active_directory,enumeration,discovery,">

  <rule id="110400" level="0">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Security$</field>
    <description>Base rule for AD Enumeration events</description>
  </rule>

  <rule id="110401" level="8">
    <if_sid>110400</if_sid>
    <field name="win.system.eventID">^4799$</field>
    <description>AD: Local group enumeration - User $(win.eventdata.subjectUserName) enumerated $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1069</id>
    </mitre>
    <group>group_enumeration,discovery,</group>
  </rule>

  <rule id="110402" level="12">
    <if_sid>110400</if_sid>
    <field name="win.system.eventID">^4799$</field>
    <field name="win.eventdata.targetUserName">^Administrators$</field>
    <description>AD: CRITICAL - User $(win.eventdata.subjectUserName) enumerated the Administrators group</description>
    <mitre>
      <id>T1069</id>
    </mitre>
    <group>group_enumeration,discovery,critical,</group>
  </rule>

</group>

<!-- ============================================= -->
<!-- WINDOWS KERBEROS & AUTHENTICATION             -->
<!-- ============================================= -->

<group name="active_directory,kerberos,authentication,">

  <rule id="110100" level="0">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Security$</field>
    <description>Base rule for Active Directory Security events</description>
  </rule>

  <rule id="110101" level="5">
    <if_sid>110100</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.Status">^0x0$</field>
    <description>AD: Kerberos TGT requested for user $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1558</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="110102" level="5">
    <if_sid>110100</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.status">^0x0$</field>
    <description>AD: Kerberos service ticket requested - User: $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1558</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="110103" level="7">
    <if_sid>110100</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.Status" negate="yes">^0x0$</field>
    <description>AD: FAILED Kerberos TGT request - User: $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1558</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="110104" level="8">
    <if_sid>110100</if_sid>
    <field name="win.system.eventID">^4740$</field>
    <description>AD: User account locked out - $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>account_lockout,</group>
  </rule>

  <rule id="110105" level="6">
    <if_sid>110100</if_sid>
    <field name="win.system.eventID">^4672$</field>
    <description>AD: Admin privileges assigned to $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>privilege_escalation,admin_logon,</group>
  </rule>

  <rule id="110106" level="4">
    <if_sid>110100</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <description>AD: User logon - $(win.eventdata.targetUserName) from IP $(win.eventdata.ipAddress)</description>
    <group>authentication_success,logon,</group>
  </rule>

</group>

