<!-- ============================================= -->
<!-- KERBEROS BRUTE FORCE ATTACKS (4771)           -->
<!-- ============================================= -->

<group name="active_directory,kerberos_failure,bruteforce,">

  <rule id="110300" level="0">
    <if_sid>60000</if_sid>
    <field name="win.system.eventID">^4771$</field>
    <description>Base rule for Kerberos pre-authentication failures</description>
  </rule>

  <rule id="110301" level="12" frequency="5" timeframe="30" ignore="10">
    <if_matched_sid>110300</if_matched_sid>
    <same_source_ip />
    <description>AD: KERBEROS BRUTE FORCE - Multiple failed authentications from IP $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>kerberos_bruteforce,active_attack,</group>
  </rule>

</group>

<!-- ============================================= -->
<!-- AD ATTACK DETECTION - LINUX (Auditd)          -->
<!-- ============================================= -->

<group name="ad_attacks,linux,audit,">

  <!-- Kerberoasting detection (GetUserSPNs.py) -->
  <rule id="110500" level="12">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)GetUserSPNs</field>
    <description>Kerberoasting attack detected - GetUserSPNs.py executed by $(audit.user)</description>
    <mitre>
      <id>T1558</id>
      <id>T1558.003</id>
    </mitre>
  </rule>

  <!-- AS-REP Roasting detection (GetNPUsers.py) -->
  <rule id="110501" level="12">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)GetNPUsers</field>
    <description>AS-REP Roasting attack detected - GetNPUsers.py executed by $(audit.user)</description>
    <mitre>
      <id>T1558</id>
      <id>T1558.004</id>
    </mitre>
  </rule>

  <!-- DCSync / Secretsdump detection -->
  <rule id="110502" level="15">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)secretsdump|dcsync</field>
    <description>DCSync/Credential dumping detected - $(audit.execve.a1) executed by $(audit.user)</description>
    <mitre>
      <id>T1003</id>
      <id>T1003.006</id>
    </mitre>
  </rule>

  <!-- Lateral Movement tools (psexec, wmiexec, etc.) -->
  <rule id="110503" level="13">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)psexec|wmiexec|atexec|smbexec</field>
    <description>Lateral movement attack detected - $(audit.execve.a1) executed by $(audit.user)</description>
    <mitre>
      <id>T1021</id>
    </mitre>
  </rule>

  <!-- Golden/Silver Ticket tools -->
  <rule id="110504" level="15">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)ticketer|golden_ticket|kerberos::golden</field>
    <description>Golden/Silver Ticket attack detected - $(audit.execve.a1) executed by $(audit.user)</description>
    <mitre>
      <id>T1558</id>
      <id>T1558.001</id>
    </mitre>
  </rule>

  <!-- Impacket general detection -->
  <rule id="110505" level="10">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)impacket</field>
    <description>Impacket tool executed - $(audit.execve.a1) by $(audit.user)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- CrackMapExec detection -->
  <rule id="110506" level="10">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)crackmapexec|cme</field>
    <description>CrackMapExec tool executed - $(audit.execve.a1) by $(audit.user)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- Rubeus detection -->
  <rule id="110507" level="12">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)Rubeus</field>
    <description>Rubeus Kerberos attack tool detected - executed by $(audit.user)</description>
    <mitre>
      <id>T1558</id>
    </mitre>
  </rule>

  <!-- Mimikatz detection -->
  <rule id="110508" level="15">
    <if_sid>92600</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)mimikatz</field>
    <description>Mimikatz detected - $(audit.execve.a1) executed by $(audit.user)</description>
    <mitre>
      <id>T1003</id>
      <id>T1548</id>
    </mitre>
  </rule>

</group>
