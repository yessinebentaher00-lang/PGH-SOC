
<!-- ============================================= -->
<!-- PRSOCIETY RULES                               -->
<!-- ============================================= -->

<group name="prsociety">
 
  <rule id="110001" level="0">
    <if_sid>86600</if_sid>
    <field name="app_service">prsociety</field>
    <description>Base rule for PRSociety events</description>
  </rule>

  <rule id="110002" level="3">
    <if_sid>110001</if_sid>
    <field name="auth-status">SUCCESS</field>
    <description>PRSociety: Successful login - $(username) from IP $(src_ip)</description>
    <group>authentication_success</group>
  </rule>

  <rule id="110003" level="5">
    <if_sid>110001</if_sid>
    <field name="auth-status">WRONG_PASSWORD</field>
    <description>PRSociety: Wrong password attempt - user: $(username) from IP $(src_ip)</description>
    <group>authentication_failed</group>
  </rule>

  <rule id="110004" level="5">
    <if_sid>110001</if_sid>
    <field name="auth-status">USER_NOT_FOUND</field>
    <description>PRSociety: User not found attempt - user: $(username) from IP $(src_ip)</description>
    <group>authentication_failed,user_enumeration</group>
  </rule>

  <rule id="110005" level="7">
    <if_sid>110001</if_sid>
    <field name="auth-status">RATE_LIMITED</field>
    <description>PRSociety: Rate limit triggered - 3+ failed attempts for user $(username) from IP $(src_ip)</description>
    <group>authentication_failed,rate_limited</group>
  </rule>

  <rule id="110006" level="9">
    <if_sid>110001</if_sid>
    <field name="auth-status">BRUTE_FORCE_ATTEMPT</field>
    <description>PRSociety: BRUTE_FORCE_ATTEMPT - IP $(src_ip) had multiple rate limit events in 60 seconds</description>
    <group>authentication_failed,bruteforce</group>
  </rule>

  <rule id="110007" level="10">
    <if_sid>110001</if_sid>
    <field name="auth-status">CRITICAL</field>
    <description>PRSociety: CRITICAL - IP $(src_ip) has exceeded 10 rate limit events - Ongoing brute force attack</description>
    <group>authentication_failed,bruteforce,critical</group>
  </rule>

  <rule id="110008" level="12">
    <if_sid>110001</if_sid>
    <field name="auth-status">DISTRIBUTED_ATTACK</field>
    <description>PRSociety: DISTRIBUTED_ATTACK - Large scale attack detected from multiple IPs</description>
    <group>authentication_failed,bruteforce,ddos,distributed_attack</group>
  </rule>

  <rule id="110009" level="13">
    <if_sid>110001</if_sid>
    <field name="auth-status">CRITICAL</field>
    <field name="pattern_detected">critical</field>
    <description>PRSociety: CRITICAL - Multiple attack waves from IP $(src_ip) - 3+ brute force patterns detected</description>
    <group>authentication_failed,bruteforce,critical,multiple_waves</group>
  </rule>

  <rule id="110010" level="3">
    <if_sid>110001</if_sid>
    <field name="auth-status">LOGOUT</field>
    <description>PRSociety: User $(username) logged out</description>
    <group>session</group>
  </rule>

  <rule id="110014" level="4">
    <if_sid>110001</if_sid>
    <field name="auth-status">SESSION_RESTORE</field>
    <description>PRSociety: Session restored for user $(username) from IP $(src_ip)</description>
    <group>authentication_success</group>
  </rule>

</group>

<!-- ============================================= -->
<!-- MAILCOW RULES                                 -->
<!-- ============================================= -->

<group name="Mailcow">


 
  <rule id="120001" level="0">\
    <decoded_as>json</decoded_as>\
    <field name="sender">\.+</field>\
    <description>Mailcow: log detected</description>\
  </rule>
  <rule id="120002" level="4">
    <if_sid>120001</if_sid>
    <field name="sender" type="pcre2">@(?!pghconnect\.local)</field>
    <field name="receiver" type="pcre2">@pghconnect\.local</field>
    <description>Mailcow: External email received - From: $(sender) To: $(receiver)</description>
  </rule>

  <rule id="120010" level="10">
    <if_sid>120001</if_sid>
    <field name="subject" type="pcre2">(?i)(urgent|immediate action|verify your account|account suspended|security alert|unauthorized login|suspicious activity|reactivate|deactivate|locked|compromised)</field>
    <description>Mailcow - Phishing: Urgent/action required subject line - $(subject)</description>
  </rule>

  <rule id="120011" level="10">
    <if_sid>120001</if_sid>
    <field name="subject" type="pcre2">(?i)(password|passphrase|credential|login|signin|verify your identity|reset your|change your|update your)</field>
    <description>Mailcow - Phishing: Password/credential related subject - $(subject)</description>
  </rule>

  <rule id="120012" level="10">
    <if_sid>120001</if_sid>
    <field name="subject" type="pcre2">(?i)(invoice|payment|bill|refund|transaction|bank|paypal|credit card|debit card|visa|mastercard|amazon|apple|google|microsoft)</field>
    <description>Mailcow - Phishing: Financial/brand impersonation subject - $(subject)</description>
  </rule>

  <rule id="120013" level="8">
    <if_sid>120001</if_sid>
    <field name="sender" type="pcre2">(?i)(paypal|amazon|apple|microsoft|dhl|fedex|ups|bank|chase|wellsfargo|citi)\.(?!com|org|net)</field>
    <description>Mailcow - Phishing: Suspicious sender domain spoofing - $(sender)</description>
  </rule>

  <rule id="120014" level="7">
    <if_sid>120001</if_sid>
    <field name="sender" type="pcre2">^[^@]+$</field>
    <description>Mailcow - Phishing: Invalid sender format (missing domain) - $(sender)</description>
  </rule>

  <rule id="120015" level="4">
    <if_sid>120001</if_sid>
    <field name="sender" type="pcre2">@pghconnect\.local</field>
    <field name="receiver" type="pcre2">@pghconnect\.local</field>
    <description>Mailcow - Phishing: Internal to internal email - $(sender) -> $(receiver)</description>
  </rule>

  <rule id="120017" level="9">
    <if_sid>120001</if_sid>
    <field name="body" type="pcre2">(?i)(click here|verify now|confirm your account|login to|sign in to|update your information|https?://bit\.ly|https?://tinyurl|https?://shorturl|http://(?!s))</field>
    <description>Mailcow - Phishing: Suspicious body content (links/action words) detected</description>
  </rule>

  <rule id="120018" level="10">
    <if_sid>120001</if_sid>
    <field name="body" type="pcre2">https?://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}</field>
    <description>Mailcow - Phishing: Email contains IP address URL (suspicious)</description>
  </rule>

  <rule id="120019" level="6">
    <if_sid>120001</if_sid>
    <field name="body" type="pcre2">(https?://[^\s]+).*\1</field>
    <description>Mailcow - Suspicious: Email contains multiple URLs</description>
  </rule>

  <rule id="120020" level="10">
    <if_sid>120001</if_sid>
    <field name="body" type="pcre2">(?i)(ssn|social security|date of birth|driver.?s license|mother.?s maiden|credit card|bank account|routing number|password|verify your identity)</field>
    <description>Mailcow - Phishing: Request for personal/sensitive information detected</description>
  </rule>

  <rule id="120021" level="8">
    <if_sid>120001</if_sid>
    <field name="body" type="pcre2">(?i)(attached|attachment|see attached|view attached|download|invoice\.pdf|document\.pdf|report\.zip)</field>
    <description>Mailcow - Suspicious: Email mentions attachment (potential malware)</description>
  </rule>

</group>

<!-- ============================================= -->
<!-- SUSPICIOUS COMMANDS DETECTION (CDB List Based) -->
<!-- ============================================= -->

<group name="prsociety,log,commands,suspicious">

  <rule id="110050" level="0">
    <if_sid>80792</if_sid>
    <description>Base rule for command monitoring</description>
  </rule>

  <rule id="110051" level="6">
    <if_sid>110050</if_sid>
    <list field="audit.command" lookup="match_key_value" check_value="yellow">etc/lists/suspicious-programs</list>
    <description>PRSociety: LOW - Suspicious command executed: $(audit.exe) by user $(audit.user)</description>
    <group>suspicious_command,yellow_severity</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

</group>

<!-- ============================================= -->
<!-- OVERRIDE BUILT-IN PYTHON RULE TO LEVEL 7      -->
<!-- ============================================= -->

<group name="override_python,">

  <rule id="92600" level="7" overwrite="yes">
    <if_sid>80792</if_sid>
    <match>python</match>
    <description>Python script executed - $(audit.exe)</description>
    <mitre>
      <id>T1059.006</id>
    </mitre>
    <group>python_execution,</group>
  </rule>

</group>

